{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WallpaperEM",
        "width": 1240,
        "height": 800,
        "minWidth": 940,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "shadow": true,
        "transparent": true,
        "devtools": false
      }
    ]
  },
  "bundle": {
    "targets": [
      "deb",
      "appimage"
    ],
    "resources": {
      "../dist/renderer": "renderer",
      "../dist/assets": "assets",
      "bundled/libsteam_api.so": "libsteam_api.so"
    }
  }
}
