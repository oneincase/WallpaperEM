{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WallpaperEM",
  "version": "1.1.0",
  "identifier": "io.github.oneincase.wallpaperem",
  "build": {
    "beforeDevCommand": "pnpm --filter @we/desktop dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @we/desktop build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "WallpaperEM",
        "width": 1240,
        "height": 800,
        "minWidth": 940,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "shadow": true,
        "transparent": true,
        "devtools": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist/renderer": "renderer",
      "../dist/assets": "assets"
    },
    "macOS": {
      "entitlements": "entitlements.plist",
      "signingIdentity": "WallpaperEM Dev Signer",
      "files": {
        "MacOS/libsteam_api.dylib": "sdk/osx/libsteam_api.dylib"
      }
    },
    "linux": {
      "appimage": {},
      "deb": {
        "depends": [
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav"
        ],
        "recommends": [
          "gstreamer1.0-pipewire",
          "ffmpeg"
        ]
      }
    },
    "category": "Utility",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY1NUJEOUVFMTQ0MTJGQTcKUldTbkwwRVU3dGxiOWVWc2dob2lDZ2EwckI4b2tyYzh2ZGpaUC92QURyTExVSnRKMUpiTVNCVEcK",
      "endpoints": [
        "https://github.com/oneincase/WallpaperEM/releases/latest/download/latest-{{target}}-{{arch}}.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
