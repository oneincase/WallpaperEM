{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WallpaperEM",
  "version": "0.2.0",
  "identifier": "io.github.oneincase.wallpaperem",
  "build": {
    "beforeDevCommand": "pnpm --filter @we/desktop dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @we/desktop build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "WallpaperEM",
        "width": 1240,
        "height": 800,
        "minWidth": 940,
        "minHeight": 600,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "externalBin": ["binaries/depot-downloader"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": {
      "../dist/renderer": "renderer",
      "../dist/assets": "assets",
      "../dist/default-wallpaper": "default-wallpaper"
    }
  }
}
