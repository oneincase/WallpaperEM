{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WallpaperEM",
        "width": 1240,
        "height": 800,
        "minWidth": 940,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "shadow": true,
        "transparent": true,
        "devtools": false
      }
    ]
  },
  "bundle": {
    "targets": [
      "nsis",
      "msi"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    },
    "resources": {
      "../dist/renderer": "renderer",
      "../dist/assets": "assets",
      "sdk/win64/steam_api64.dll": "steam_api64.dll"
    }
  }
}
