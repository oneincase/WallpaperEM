{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": [
      "nsis",
      "msi"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    },
    "resources": {
      "../dist/renderer": "renderer",
      "../dist/assets": "assets",
      "sdk/win64/steam_api64.dll": "steam_api64.dll"
    }
  }
}
