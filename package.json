{
  "name": "@we/desktop",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev-guard.mjs && vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "tauri": "tauri",
    "prepare": "node scripts/install-hooks.mjs --if-possible",
    "hooks:install": "node scripts/install-hooks.mjs",
    "hooks:status": "node scripts/install-hooks.mjs --status",
    "hooks:uninstall": "node scripts/install-hooks.mjs --uninstall",
    "lint:commit": "node scripts/commit-msg-lint.mjs",
    "size:check": "node scripts/pr-size-check.mjs",
    "versions:check": "node scripts/check-versions.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "webwallgl": "file:../webwallgl-github/dist/lib"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0"
  }
}
